{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript \"${OPENAPI_SPEC:-https://raw.githubusercontent.com/annakonn200059/job-tracker-api/$(cat api/openapi-ref)/api/openapi.yaml}\" --output api/schema.gen.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.104.0",
    "@workspace/ui": "*",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9.39.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
